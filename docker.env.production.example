# Copy this to .env.production for the Docker/VPS stack.
# Do not commit the real .env.production file.

# Required by the backend production guard.
# Generate with:
# python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-strong-random-secret-min-32-chars

# LLM providers.
GROQ_API_KEY=your_groq_key_here
GROQ_API_KEY_IMPACT=your_groq_key_here
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_key_here

# Optional app/domain overrides.
# PUBLIC_APP_URL includes the /app path used by portfolio links.
# FRONTEND_ORIGIN is origin-only for backend CORS, so do not add a path.
PUBLIC_APP_URL=https://testsurge.kynetropo.com/app
FRONTEND_ORIGIN=https://testsurge.kynetropo.com

# Optional admin defaults.
ADMIN_EMAIL=admin@kynetropo.com
ADMIN_PASSWORD=replace-this-admin-password

# Optional email/Stripe/Sentry integrations.
AWS_SES_REGION=us-east-1
AWS_SES_ACCESS_KEY=
AWS_SES_SECRET_KEY=
MAIL_DEFAULT_SENDER=noreply@kynetropo.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SENTRY_DSN=

# Optional local Postgres overrides used by docker compose interpolation.
POSTGRES_DB=test_case_gen
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
