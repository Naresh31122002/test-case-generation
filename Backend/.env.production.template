# ── Database (Neon) ─────────────────────────────────────────────
# Get this from neon.tech → your project → Connection string
# Use the "pooled" connection string for production
DATABASE_URL=postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Neon also accepts individual vars (used by config.py)
POSTGRES_HOST=ep-xxx.ap-southeast-1.aws.neon.tech
POSTGRES_DB=neondb
POSTGRES_USER=your_neon_user
POSTGRES_PASSWORD=your_neon_password
POSTGRES_PORT=5432

# ── LLM API Keys ─────────────────────────────────────────────────
GROQ_API_KEY=your_groq_key_here
GROQ_API_KEY_IMPACT=your_groq_key_here
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_key_here

# ── LanceDB ──────────────────────────────────────────────────────
# On Railway this persists inside the container volume
LANCE_DB_PATH=/app/data/lance_db
TABLE_NAME_LANCE=user_stories

# ── Frontend ─────────────────────────────────────────────────────
# The deployed Next.js URL — used for CORS
FRONTEND_URL=https://testforge.kynetropo.com

# ── Flask ────────────────────────────────────────────────────────
FLASK_ENV=production
FLASK_DEBUG=0

# ── Auth ─────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Must be a strong random secret — do NOT commit the real value to git
JWT_SECRET_KEY=replace-with-a-strong-random-secret-min-32-chars

# ── Admin Dashboard ────────────────────────────────────────────────
# Required — the app refuses to start without both. There is no default
# admin account. Use a real mailbox you control and a unique password
# (min 12 chars in production, enforced at startup); do NOT reuse this
# password anywhere else, and do NOT commit the real values to git.
# Generate a password with: python -c "import secrets; print(secrets.token_urlsafe(18))"
ADMIN_EMAIL=replace-with-your-real-admin-email
ADMIN_PASSWORD=replace-with-a-strong-unique-password-min-12-chars
